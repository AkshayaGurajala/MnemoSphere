{
  "manifest_version": 3,
  "name": "MnemoSphere",
  "version": "1.0",
  "description": "Save useful webpages into your AI digital memory.",
  "permissions": ["tabs", "activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:5000/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MnemoSphere"
  }
}